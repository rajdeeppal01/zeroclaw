generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id             Int      @id @default(autoincrement())
  cn             String   @unique
  reputation     Float    @default(1.0)
  is_quarantined      Boolean   @default(false)
  quarantine_reset_at DateTime?
  unquarantined_by_id Int?
  created_at          DateTime  @default(now())
  
  threats             Threat[]
  unquarantined_by    Analyst?  @relation("AnalystUnquarantines", fields: [unquarantined_by_id], references: [id])
}

model Analyst {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash  String
  created_at     DateTime @default(now())
  
  threats_reviewed Threat[] @relation("ReviewedThreats")
  threats_revoked  Threat[] @relation("RevokedThreats")
  clients_unquarantined Client[] @relation("AnalystUnquarantines")
  onboarding_approvals OnboardingRequest[] @relation("AnalystApprovals")
}

model Threat {
  id             Int       @id @default(autoincrement())
  stix_id        String    @unique
  client_id      Int
  stix_data      Json
  status         String    @default("pending_review") // "pending_review", "approved", "rejected", "quarantined"
  created_at     DateTime  @default(now())
  reviewed_at    DateTime?
  reviewed_by_id Int?
  revoked_at     DateTime?
  revoked_by_id  Int?

  client         Client    @relation(fields: [client_id], references: [id])
  analyst        Analyst?  @relation("ReviewedThreats", fields: [reviewed_by_id], references: [id])
  revoker        Analyst?  @relation("RevokedThreats", fields: [revoked_by_id], references: [id])

  @@index([client_id, created_at])
}

model OnboardingRequest {
  id               Int      @id @default(autoincrement())
  tracking_token   String   @unique
  username         String
  status           String   @default("pending") // pending, approved, signed, rejected, downloaded
  csr_pem          String
  cert_pem         String?
  private_key_pem  String?
  
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  approved_by_id   Int?
  approved_by      Analyst? @relation("AnalystApprovals", fields: [approved_by_id], references: [id])
}

model Waitlist {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  created_at DateTime @default(now())
  status     String   @default("pending") // "pending", "contacted", "onboarded"
}
